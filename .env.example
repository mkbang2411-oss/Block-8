# Supabase -> Project Settings -> Database -> Connection string (nên dùng Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
PORT=3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Xác thực ----
NODE_ENV=development
# URL công khai của web (dùng cho cookie Secure và để email OTP tải được ảnh nền Hội An). Production: bắt buộc đặt, vd https://ten-ban.onrender.com
APP_URL=http://localhost:3000

# ---- Gửi email OTP (chọn 1 trong 2; để trống cả hai khi dev -> mã OTP được in ra console) ----
MAIL_FROM="Cái Quán Ăn <no-reply@example.com>"
# Cách 1: SMTP (Gmail: bật 2FA rồi tạo App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Cách 2: Resend (HTTPS API, dùng được khi host chặn cổng SMTP)
RESEND_API_KEY=

# ---- "Tôi không phải là người máy" ở bước 1 đăng ký, trước khi gửi OTP (Google reCAPTCHA v2 checkbox, tùy chọn) ----
# Để trống cả hai: giao diện dùng ô giả lập và server không kiểm tra (chỉ nên dùng khi dev).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# (tùy chọn) Server kiểm tra `hostname` Google trả về phải khớp hostname của APP_URL. Nếu web có thêm tên miền khác, liệt kê ở đây, cách nhau dấu phẩy.
RECAPTCHA_HOSTNAMES=

# ---- Seed: tài khoản đầu bếp mẫu đã xác minh (tùy chọn) ----
SEED_CHEF_EMAIL=
SEED_CHEF_PASSWORD=
