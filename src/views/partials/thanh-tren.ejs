<%# thanh nút phía trên: Ra phố | (tuỳ trang) | Đăng nhập | Đăng xuất (khi đã đăng nhập đầu bếp) %>
<div class="thanh">
  <a class="nut nut-phu" href="/">Ra phố</a>
  <div class="tabs">
    <% if (locals.tabs) { tabs.forEach(function (t) { %>
      <a class="nut tab<%= t.on ? ' on' : '' %>" href="<%= t.href %>"><%= t.label %></a>
    <% }) } %>
  </div>
  <div class="tabs">
    <% if (locals.themHref) { %><a class="nut" href="<%= themHref %>"><%= themLabel %></a><% } %>
    <% if (!role) { %><a class="nut nut-phu" href="/login">Đăng nhập</a><% } else { %>
      <form method="post" action="/logout" style="display:inline"><button class="nut nut-phu" title="<%= locals.user ? user.email : '' %>">Đăng xuất</button></form>
    <% } %>
  </div>
</div>
