<%# ô captcha ảnh: ảnh lấy từ GET /captcha (server ghi đáp án vào DB), bấm "Đổi ảnh" để lấy ảnh mới %>
<% const capLoi = locals.capLoi; %>
<div class="truong <%= capLoi ? 'co-loi' : '' %>">
  <label for="captcha">Nhập mã trong ảnh</label>
  <div class="captcha-hang">
    <img id="captcha-anh" src="/captcha?t=<%= Date.now() %>" alt="Mã captcha" width="160" height="56">
    <button type="button" class="nut nut-phu" onclick="var i=document.getElementById('captcha-anh');i.src='/captcha?t='+Date.now();document.getElementById('captcha').value='';document.getElementById('captcha').focus()">Đổi ảnh</button>
  </div>
  <input type="text" id="captcha" name="captcha" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="8" required>
  <% if (capLoi) { %><small class="chu-loi"><%= capLoi %></small><% } %>
</div>
