<%- include('../partials/head', { title: 'Quên mật khẩu', am: 'quan' }) %>
<%- include('../partials/auth-style') %>
<main class="man trang cuon">
  <div class="thanh"><a class="nut nut-phu" href="/">Ra phố</a><div class="tabs"><a class="nut nut-phu" href="/login">Đăng nhập</a></div></div>
  <form class="hop hop-giua" method="post" action="/forgot-password">
    <h2>Quên mật khẩu</h2>
    <p class="phu-chu">Nhập email đã đăng ký, chúng tôi sẽ gửi mã OTP 6 số.</p>
    <% if (error) { %><div class="bao-loi"><%= error %></div><% } %>
    <div class="truong">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" required maxlength="254">
    </div>
    <%- include('../partials/captcha') %>
    <div class="nut-hang"><button class="nut">Gửi mã OTP</button></div>
    <div class="auth-lk"><a href="/reset-password">Đã có mã OTP?</a></div>
  </form>
</main>
<%- include('../partials/foot') %>
