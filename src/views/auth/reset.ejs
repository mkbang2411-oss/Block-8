<%- include('../partials/head', { title: 'Đặt lại mật khẩu', am: 'quan' }) %>
<%- include('../partials/auth-style') %>
<main class="man trang cuon">
  <div class="thanh"><a class="nut nut-phu" href="/">Ra phố</a><div class="tabs"><a class="nut nut-phu" href="/login">Đăng nhập</a></div></div>
  <form class="hop hop-giua" method="post" action="/reset-password" autocomplete="off">
    <h2>Đặt lại mật khẩu</h2>
    <% if (sent) { %><div class="bao-ok">Nếu email có tài khoản, mã OTP 6 số đã được gửi (hiệu lực 10 phút). Nhập mã và mật khẩu mới bên dưới.</div><% } %>
    <% if (error) { %><div class="bao-loi"><%= error %> <a href="/forgot-password">Gửi mã mới</a></div><% } %>
    <div class="truong <%= errors.email ? 'co-loi' : '' %>">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" required maxlength="254">
      <% if (errors.email) { %><small class="chu-loi"><%= errors.email %></small><% } %>
    </div>
    <div class="truong <%= errors.otp ? 'co-loi' : '' %>">
      <label for="otp">Mã OTP (6 số)</label>
      <input type="text" id="otp" name="otp" inputmode="numeric" pattern="\d{6}" maxlength="6" autocomplete="one-time-code" required>
      <% if (errors.otp) { %><small class="chu-loi"><%= errors.otp %></small><% } %>
    </div>
    <div class="truong <%= errors.password ? 'co-loi' : '' %>">
      <label for="password">Mật khẩu mới</label>
      <input type="password" id="password" name="password" autocomplete="new-password" required minlength="8" maxlength="72" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)\S{8,72}">
      <small class="goi-y-nho">8–72 ký tự, có chữ thường, chữ HOA và số, không chứa khoảng trắng.</small>
      <% if (errors.password) { %><small class="chu-loi"><%= errors.password %></small><% } %>
    </div>
    <div class="truong <%= errors.password2 ? 'co-loi' : '' %>">
      <label for="password2">Nhập lại mật khẩu mới</label>
      <input type="password" id="password2" name="password2" autocomplete="new-password" required maxlength="72">
      <% if (errors.password2) { %><small class="chu-loi"><%= errors.password2 %></small><% } %>
    </div>
    <%- include('../partials/captcha', { capLoi: errors.captcha }) %>
    <div class="nut-hang"><button class="nut">Đổi mật khẩu</button></div>
    <div class="auth-lk"><a href="/forgot-password">Gửi lại mã OTP</a></div>
  </form>
</main>
<%- include('../partials/foot') %>
