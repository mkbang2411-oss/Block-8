<%- include('partials/head', { title: 'Đăng nhập đầu bếp', am: 'quan' }) %>
<%- include('partials/auth-style') %>
<main class="man trang cuon">
  <div class="thanh"><a class="nut nut-phu" href="/">Ra phố</a><div class="tabs"><a class="nut nut-phu" href="/khach">Xem thực đơn</a></div></div>
  <form class="hop hop-giua" method="post" action="/login" autocomplete="on">
    <h2>Đăng nhập đầu bếp</h2>
    <p class="phu-chu">Khách chỉ cần xem thực đơn, không cần đăng nhập.</p>
    <% if (locals.info) { %><div class="bao-ok"><%= info %></div><% } %>
    <% if (error) { %><div class="bao-loi"><%= error %><% if (canResend) { %> <a href="/resend-verification">Gửi lại email xác nhận</a><% } %></div><% } %>
    <input type="hidden" name="next" value="<%= next %>">
    <div class="truong">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required maxlength="254">
    </div>
    <div class="truong">
      <label for="password">Mật khẩu</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required maxlength="200">
    </div>
    <%- include('partials/captcha') %>
    <div class="nut-hang"><button class="nut">Đăng nhập</button></div>
    <div class="auth-lk"><a href="/register">Đăng ký tài khoản đầu bếp</a><a href="/forgot-password">Quên mật khẩu?</a><a href="/resend-verification">Chưa nhận được email xác nhận?</a></div>
  </form>
</main>
<%- include('partials/foot') %>
