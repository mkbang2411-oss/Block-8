<%# Trang ĐĂNG NHẬP / ĐĂNG KÝ (ban đêm): sông + thuyền bên trái, hoa đăng trôi, khung đăng nhập/đăng ký bên phải.
    tab = 'login' | 'register' (GET /login, GET /register dùng chung 1 view; JS chuyển tab không tải lại trang).
    Các form gọi API thật (routes/auth.js) bằng fetch JSON, xem public/js/dang-nhap.js %>
<% const tab = locals.tab === 'register' ? 'register' : locals.tab === 'reset' ? 'reset' : 'login'; %>
<%- include('partials/head', { title: tab === 'register' ? 'Đăng ký' : tab === 'reset' ? 'Đặt lại mật khẩu' : 'Đăng nhập', am: 'quan' }) %>
<main class="man dn" data-tab="<%= tab %>" data-next="<%= locals.next || '' %>" data-notice="<%= locals.notice || '' %>">
  <%# ---- bầu trời đêm: sao nhấp nháy + 2 vệt sáng ánh trăng (dịu hơn trang phố) ---- %>
  <div class="dn-troi" aria-hidden="true">
    <% for (let k = 0; k < 22; k++) { %><i class="dn-sao" style="--x:<%= 2 + Math.floor(Math.random() * 96) %>%;--y:<%= 2 + Math.floor(Math.random() * 56) %>%;--s:<%= (1.2 + Math.random() * 1.8).toFixed(1) %>px;--t:<%= (2.4 + Math.random() * 3).toFixed(1) %>s;--dl:-<%= (Math.random() * 5).toFixed(1) %>s"></i><% } %>
  </div>
  <div class="nang" aria-hidden="true"><i class="tia"></i><i class="tia nho"></i></div>

  <%# ---- sông chiếm hơn nửa chiều cao màn hình (--song-h trong style.css) ---- %>
  <div class="dn-song" aria-hidden="true">
    <div class="dn-song-nuoc"></div>
    <% for (let k = 0; k < 16; k++) { %><i class="dn-lap" style="--x:<%= 2 + Math.floor(Math.random() * 96) %>%;--y:<%= 10 + Math.floor(Math.random() * 84) %>%;--s:<%= 8 + Math.floor(Math.random() * 8) %>px;--t:<%= (2.4 + Math.random() * 2.4).toFixed(1) %>s;--dl:-<%= (Math.random() * 5).toFixed(1) %>s"></i><% } %>
  </div>

  <i class="dn-mep sau" aria-hidden="true"></i><i class="dn-mep" aria-hidden="true"></i>

  <%# ---- thuyền nằm giữa chiều cao màn hình, lệch về bên trái ---- %>
  <div class="dn-thuyen" aria-hidden="true">
    <img src="/img/thuyen.webp" width="1400" height="369" alt="" draggable="false" decoding="async">
  </div>

  <%# ---- 10 hoa đăng (3 loại), trôi nhẹ tại chỗ. t = loại đèn | x = vị trí ngang (%) | b = độ cao trên dải sông (%) | k = cỡ ---- %>
  <% const den = [
    { t: 1, x: 4,  b: 58, k: 0.72, du: 6.2 }, { t: 2, x: 22, b: 54, k: 0.80, du: 7.4 },
    { t: 3, x: 40, b: 60, k: 0.68, du: 5.6 }, { t: 1, x: 3,  b: 28, k: 1.00, du: 7.0 },
    { t: 3, x: 16, b: 5,  k: 1.20, du: 6.6 }, { t: 2, x: 33, b: 9,  k: 1.10, du: 5.8 },
    { t: 1, x: 47, b: 40, k: 0.90, du: 7.8 }, { t: 3, x: 53, b: 70, k: 0.65, du: 6.0 },
    { t: 2, x: 64, b: 4,  k: 1.15, du: 7.2 }, { t: 1, x: 82, b: 3,  k: 1.00, du: 6.4 },
    { t: 2, x: 12, b: 42, k: 0.90, du: 6.8 }, { t: 3, x: 28, b: 28, k: 1.00, du: 7.6 }
  ]; %>
  <div class="dn-den-ds" aria-hidden="true">
    <% den.forEach(function (d, i) { %><span class="dn-den t<%= d.t %>" style="--x:<%= d.x %>%;--b:<%= d.b %>;--k:<%= d.k %>;--du:<%= d.du %>s;--dl:-<%= (i * 1.3).toFixed(1) %>s;z-index:<%= d.b < 30 ? 5 : 3 %>"><img src="/img/dang-nhap/den-<%= d.t %>.webp?v=2" width="360" height="421" alt="" draggable="false" decoding="async"></span>
    <% }) %>
  </div>

  <a class="dn-ve" href="/"><svg viewBox="0 0 20 14" width="16" height="12" aria-hidden="true"><path d="M19 7H2M7 1.5 1.5 7 7 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Trang chủ</a>

  <%# ================== KHUNG ĐĂNG NHẬP / ĐĂNG KÝ ================== %>
  <section class="dn-the" aria-label="Đăng nhập và đăng ký">
    <div class="dn-tab" role="tablist" aria-label="Chọn đăng nhập hoặc đăng ký"<%- tab === 'reset' ? ' hidden style="display:none"' : '' %>>
      <button type="button" role="tab" class="dn-tab-nut<%= tab === 'login' ? ' on' : '' %>" id="tab-dn" data-tab="login" aria-controls="p-dn" aria-selected="<%= tab === 'login' %>" tabindex="<%= tab === 'login' ? 0 : -1 %>">Đăng nhập</button>
      <button type="button" role="tab" class="dn-tab-nut<%= tab === 'register' ? ' on' : '' %>" id="tab-dk" data-tab="register" aria-controls="p-dk" aria-selected="<%= tab === 'register' %>" tabindex="<%= tab === 'register' ? 0 : -1 %>">Đăng ký</button>
      <i class="dn-tab-vach" aria-hidden="true"></i>
    </div>

    <%# ---------- ĐĂNG NHẬP ---------- %>
    <div class="dn-pane" id="p-dn" role="tabpanel" aria-labelledby="tab-dn"<%- tab === 'login' ? '' : ' hidden' %>>
      <h1 class="dn-tieude">Chào mừng trở lại</h1>
      <p class="dn-phu">Đăng nhập để tiếp tục sử dụng hệ thống.</p>
      <div class="bao-loi" id="dn-loi-chung" role="alert"<%- (locals.error && tab === 'login') ? '' : ' hidden' %>><%= (tab === 'login' && locals.error) ? error : '' %></div>
      <form id="f-dn" method="post" action="/login" novalidate>
        <input type="hidden" name="next" value="<%= locals.next || '' %>">
        <label class="dn-truong"><span>Địa chỉ email</span>
          <input type="email" name="email" autocomplete="username" placeholder="ten@email.com" value="<%= locals.email || '' %>" required>
          <small class="dn-loi" role="alert"></small></label>
        <label class="dn-truong"><span>Mật khẩu</span>
          <span class="dn-mk"><input type="password" name="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required>
            <button type="button" class="dn-mat" aria-label="Hiện mật khẩu" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path class="gach" d="M4 4l16 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></span>
          <small class="dn-loi" role="alert"></small></label>
        <%# CAPTCHA đăng nhập: luôn có trong trang nhưng ẨN, chỉ hiện khi đã đăng nhập sai từ 3 lần (server quyết định: needCaptcha; JS bỏ hidden khi server báo needCaptcha). Có RECAPTCHA_SITE_KEY thì reCAPTCHA thật, không thì ô giả lập (dev) %>
        <div id="dn-cap-khoi"<%- locals.needCaptcha ? '' : ' hidden' %>>
        <% if (locals.recaptchaSiteKey) { %>
        <div class="dn-rc"><div class="g-recaptcha" id="cap-dn-rc" data-sitekey="<%= recaptchaSiteKey %>"></div></div>
        <% } else { %>
        <div class="dn-cap" id="cap-dn" role="checkbox" aria-checked="false" aria-labelledby="cap-dn-chu" tabindex="0">
          <span class="dn-cap-o" aria-hidden="true"></span>
          <span class="dn-cap-chu" id="cap-dn-chu">Tôi không phải là người máy</span>
          <svg class="dn-cap-hinh" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 2.5 4.5 5.8v5.6c0 4.6 3.1 8.1 7.5 10.1 4.4-2 7.5-5.5 7.5-10.1V5.8z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m8.6 12.2 2.4 2.4 4.4-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <input type="hidden" name="recaptcha" id="cap-dn-val" value="">
        <% } %>
        <small class="dn-loi" id="loi-cap-dn" role="alert"></small>
        </div>
        <a class="dn-quen" href="/login" id="quen-mk">Quên mật khẩu?</a>
        <button class="dn-nut" type="submit"><span>Đăng nhập</span></button>
      </form>
      <p class="dn-chuyen">Chưa có tài khoản? <a href="/register" data-chuyen="register">Đăng ký ngay</a></p>
    </div>

    <%# ---------- QUÊN MẬT KHẨU (không phải tab: mở từ link "Quên mật khẩu?"): nhập email -> server gửi EMAIL CHỨA LINK đặt lại mật khẩu (/reset-password?token=...) ---------- %>
    <div class="dn-pane" id="p-qm" role="region" aria-labelledby="qm-tieude" hidden>
      <div id="qm-dau">
        <h1 class="dn-tieude" id="qm-tieude">Quên mật khẩu</h1>
        <p class="dn-phu" id="qm-phu">Nhập email đã đăng ký, chúng tôi sẽ gửi một đường link để bạn đặt lại mật khẩu.</p>
      </div>

      <form class="dn-q" id="f-q1" novalidate>
        <label class="dn-truong"><span>Địa chỉ email</span>
          <input type="email" name="email" autocomplete="username" placeholder="ten@email.com" required>
          <small class="dn-loi" role="alert"></small></label>
        <button class="dn-nut" type="submit"><span>Gửi link đặt lại mật khẩu</span></button>
      </form>

      <%# đã gửi: luôn hiện thông báo này dù email có tài khoản hay không %>
      <div class="dn-xong" id="qm-xong" hidden>
        <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="3.5"/><path d="m19 33 9 9 18-20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h1 class="dn-tieude">Hãy kiểm tra email</h1>
        <p class="dn-phu" id="qm-xong-phu"></p>
        <div class="dn-phu-hang">
          <button type="button" class="dn-lk" id="q-doi-email">← Đổi email</button>
          <button type="button" class="dn-lk" id="q-gui-lai" disabled>Gửi lại link</button>
        </div>
      </div>

      <p class="dn-chuyen"><a href="/login" id="qm-ve">← Quay lại đăng nhập</a></p>
    </div>

    <%# ---------- ĐẶT LẠI MẬT KHẨU (mở từ link trong email: GET /reset-password?token=...; form thường POST /reset-password -> 303 /login?reset=1) ---------- %>
    <% if (tab === 'reset') { %>
    <div class="dn-pane" id="p-dm" role="region" aria-labelledby="dm-tieude">
      <% if (locals.resetValid === false) { %>
      <h1 class="dn-tieude" id="dm-tieude">Link không dùng được</h1>
      <div class="bao-loi" role="alert">Link đặt lại mật khẩu không hợp lệ hoặc đã hết hạn (mỗi link chỉ dùng 1 lần, hiệu lực 30 phút).</div>
      <a class="dn-nut" href="/login?quen=1" id="dm-gui-lai" style="text-align:center;text-decoration:none"><span>Gửi lại link mới</span></a>
      <% } else { const re = locals.resetErrors || {}; %>
      <h1 class="dn-tieude" id="dm-tieude">Đặt lại mật khẩu</h1>
      <p class="dn-phu">Chọn mật khẩu mới cho tài khoản của bạn.</p>
      <form id="f-dm" method="post" action="/reset-password" novalidate>
        <input type="hidden" name="token" value="<%= locals.resetToken || '' %>">
        <label class="dn-truong"><span>Mật khẩu mới</span>
          <input type="password" name="matKhau" autocomplete="new-password" placeholder="Nhập mật khẩu mới" required aria-describedby="dm-luat-mk"<%- re.matKhau ? ' class="loi" aria-invalid="true"' : '' %>>
          <ul class="dn-dk" id="dm-luat-mk" aria-live="polite"></ul>
          <small class="dn-loi" role="alert"><%= re.matKhau || '' %></small></label>
        <label class="dn-truong"><span>Nhập lại mật khẩu</span>
          <input type="password" name="matKhau2" autocomplete="new-password" placeholder="Nhập lại mật khẩu" required aria-describedby="dm-luat-mk2"<%- re.matKhau2 ? ' class="loi" aria-invalid="true"' : '' %>>
          <ul class="dn-dk" id="dm-luat-mk2" aria-live="polite"></ul>
          <small class="dn-loi" role="alert"><%= re.matKhau2 || '' %></small></label>
        <button class="dn-nut" type="submit"><span>Đặt lại mật khẩu</span></button>
      </form>
      <% } %>
      <p class="dn-chuyen"><a href="/login">← Quay lại đăng nhập</a></p>
    </div>
    <% } %>

    <%# ---------- ĐĂNG KÝ: 3 bước (1 email + xác nhận không phải người máy -> 2 mã OTP -> 3 thông tin cá nhân) ---------- %>
    <div class="dn-pane" id="p-dk" role="tabpanel" aria-labelledby="tab-dk"<%- tab === 'register' ? '' : ' hidden' %>>
      <div id="dk-dau">
        <h1 class="dn-tieude" id="dk-tieude">Xác thực email</h1>
        <p class="dn-phu" id="dk-phu">Nhập email bạn muốn dùng để đăng nhập hệ thống.</p>
        <ol class="dn-buoc" aria-label="Các bước đăng ký">
          <li class="on" data-b="1" aria-current="step"><b>1</b></li>
          <li data-b="2"><b>2</b></li>
          <li data-b="3"><b>3</b></li>
        </ol>
      </div>

      <%# Bước 1: email + xác nhận không phải người máy (CAPTCHA qua rồi server mới gửi OTP) %>
      <form class="dn-b" data-b="1" data-tieude="Xác thực email" id="f-b1" novalidate>
        <label class="dn-truong"><span>Địa chỉ email</span>
          <input type="email" name="email" autocomplete="email" placeholder="ten@email.com" required>
          <small class="dn-loi" role="alert"></small></label>
        <%# "Không phải người máy" (bước 1, TRƯỚC khi server gửi OTP): có RECAPTCHA_SITE_KEY thì hiện reCAPTCHA thật, không thì ô giả lập (server chỉ kiểm tra khi có RECAPTCHA_SECRET_KEY) %>
        <% if (locals.recaptchaSiteKey) { %>
        <div class="dn-rc"><div class="g-recaptcha" id="cap-rc" data-sitekey="<%= recaptchaSiteKey %>"></div></div>
        <% } else { %>
        <div class="dn-cap" id="cap" role="checkbox" aria-checked="false" aria-labelledby="cap-chu" tabindex="0">
          <span class="dn-cap-o" aria-hidden="true"></span>
          <span class="dn-cap-chu" id="cap-chu">Tôi không phải là người máy</span>
          <svg class="dn-cap-hinh" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 2.5 4.5 5.8v5.6c0 4.6 3.1 8.1 7.5 10.1 4.4-2 7.5-5.5 7.5-10.1V5.8z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m8.6 12.2 2.4 2.4 4.4-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <% } %>
        <small class="dn-loi" id="loi-cap" role="alert"></small>
        <button class="dn-nut" type="submit"><span>Gửi mã xác thực</span></button>
      </form>

      <%# Bước 2: OTP 6 số %>
      <form class="dn-b" data-b="2" id="f-b2" hidden novalidate>
        <div class="dn-otp" role="group" aria-label="Mã xác thực 6 số">
          <% for (let k = 0; k < 6; k++) { %><input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="<%= k === 0 ? 'one-time-code' : 'off' %>" aria-label="Số thứ <%= k + 1 %>"><% } %>
        </div>
        <small class="dn-loi giua" id="loi-otp" role="alert"></small>
        <button class="dn-nut" type="submit"><span>Xác nhận mã</span></button>
        <div class="dn-phu-hang">
          <button type="button" class="dn-lk" id="doi-email">← Đổi email</button>
          <button type="button" class="dn-lk" id="gui-lai" disabled>Gửi lại mã</button>
        </div>
      </form>

      <%# Bước 3: thông tin cá nhân %>
      <form class="dn-b" data-b="3" id="f-b3" hidden novalidate>
        <label class="dn-truong"><span>Họ và tên</span>
          <input type="text" name="hoTen" autocomplete="name" placeholder="Nguyễn Văn A" required>
          <small class="dn-loi" role="alert"></small></label>
        <label class="dn-truong"><span>Mã mời đầu bếp (không bắt buộc)</span>
          <input type="text" name="inviteCode" autocomplete="off" spellcheck="false" maxlength="100" placeholder="Bỏ trống nếu bạn là khách hàng">
          <small class="dn-loi" role="alert"></small></label>
        <label class="dn-truong"><span>Mật khẩu</span>
          <input type="password" name="matKhau" autocomplete="new-password" placeholder="Nhập mật khẩu" required aria-describedby="dk-luat-mk">
          <ul class="dn-dk" id="dk-luat-mk" aria-live="polite"></ul>
          <small class="dn-loi" role="alert"></small></label>
        <label class="dn-truong"><span>Nhập lại mật khẩu</span>
          <input type="password" name="matKhau2" autocomplete="new-password" placeholder="Nhập lại mật khẩu" required aria-describedby="dk-luat-mk2">
          <ul class="dn-dk" id="dk-luat-mk2" aria-live="polite"></ul>
          <small class="dn-loi" role="alert"></small></label>
        <small class="dn-loi giua" id="loi-dk" role="alert"></small>
        <button class="dn-nut" type="submit"><span>Hoàn tất đăng ký</span></button>
      </form>

      <%# Thành công %>
      <div class="dn-xong" id="dk-xong" hidden>
        <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="3.5"/><path d="m19 33 9 9 18-20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h1 class="dn-tieude">Đăng ký thành công</h1>
        <p class="dn-phu">Tài khoản của bạn đã sẵn sàng. Mời bạn đăng nhập để vào quán.</p>
        <button type="button" class="dn-nut" id="dk-dn"><span>Đăng nhập ngay</span></button>
      </div>

      <p class="dn-chuyen" id="dk-chan">Đã có tài khoản? <a href="/login" data-chuyen="login">Đăng nhập</a></p>
    </div>
  </section>
</main>
<%# render=explicit: trang có thể có 2 widget (đăng ký + đăng nhập khi sai >= 3 lần), JS tự vẽ từng cái và giữ id riêng %>
<% if (locals.recaptchaSiteKey) { %><script src="https://www.google.com/recaptcha/api.js?render=explicit&onload=capSan" async defer></script><% } %>
<%- include('partials/foot', { scripts: ['/js/dang-nhap.js'] }) %>
